{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/status",
      "destination": "/api?__path=status"
    },
    {
      "source": "/config",
      "destination": "/api?__path=config"
    },
    {
      "source": "/configadvanced",
      "destination": "/api?__path=configadvanced"
    },
    {
      "source": "/deviceinfo",
      "destination": "/api?__path=deviceinfo"
    },
    {
      "source": "/statusadvanced",
      "destination": "/api?__path=statusadvanced"
    },
    {
      "source": "/spectrum",
      "destination": "/api?__path=spectrum"
    },
    {
      "source": "/health",
      "destination": "/api?__path=health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
