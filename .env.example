DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Required for non-browser POST /config clients. Generate a long random value.
CONFIG_WRITE_TOKEN=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to POST configuration.
CONFIG_WRITE_ORIGINS=https://mesh-user-interface.vercel.app
# Optional. Defaults to allowing all origins.
CORS_ORIGIN=http://localhost:5173
